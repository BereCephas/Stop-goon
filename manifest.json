{
  "name": "Stop-goon",
  "description": "Extension pour bloquer les sites pour adultes automatiquement.",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js",
    "type":"module"
  },
  "permissions": ["scripting", "activeTab","storage","declarativeNetRequest"],
  "declarative_net_request" : {
    "rule_resources" : [{
      "id": "urls",
      "enabled": true,
      "path": "urls.json"
    }]
  },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["confirmation_popup.js"],
      "css": ["confirmation_popup.css"]

    }
  ],
  "web_accessible_resources": [
           {
             "resources": ["urls.json","confirmation_popup.css"],
             "matches": ["*://*/*"]
           },
                      {
             "resources": ["message/*"],
             "matches": ["*://*/*"]
           }
         ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Stop-goon actif",
    "default_popup":"popup.html"
  },
  "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
    }

}
